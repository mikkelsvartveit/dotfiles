{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true,
  "plugins": [
    {
      "package": "./tui-plugins/narrow-transcript",
      "options": { "width": 100, "align": "center" }
    }
  ]
}
