{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "lsp": false,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "webtranscriber": {
      "type": "remote",
      "url": "https://webtranscriber.com/mcp",
      "enabled": true
    },
    "localhost2": {
      "type": "remote",
      "url": "http://localhost:5173/mcp",
      "enabled": true
    }
  }
}
