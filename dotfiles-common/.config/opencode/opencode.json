{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },

    { "action": "shell", "resource": "*.env*", "effect": "deny" },

    { "action": "read", "resource": "~/.microsoft/usersecrets/*", "effect": "deny" },
    { "action": "shell", "resource": "*usersecrets*", "effect": "deny" },
    { "action": "shell", "resource": "*user-secrets list*", "effect": "deny" },

    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" }
  ],
  "provider": {
    "sference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sference",
      "options": {
        "baseURL": "https://api.sference.com/v1"
      },
      "models": {
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek-V4.1-Flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  }
}
