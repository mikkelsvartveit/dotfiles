{
  "permissions": {
    "defaultMode": "auto",
    "read": {
      "deny": [
        "**/.env*",
        "**/*.pem",
        "**/*.key",
        "**/secrets/**",
        "**/credentials/**",
        "**/.aws/**",
        "**/.ssh/**"
      ]
    }
  },
  "env": {
    "LC_CTYPE": "en_US.UTF-8"
  },
  "theme": "auto",
  "model": "opus",
  "advisorModel": "fable",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "azure@claude-plugins-official": false,
    "ponytail@ponytail": false
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  }
}
