{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/secret-guard.mjs\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "LC_CTYPE": "en_US.UTF-8"
  },
  "theme": "auto",
  "model": "opus",
  "advisorModel": "fable",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "azure@claude-plugins-official": false,
    "ponytail@ponytail": false
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  }
}
