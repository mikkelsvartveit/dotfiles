{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(!.env.template)",
      "Read(~/.microsoft/usersecrets/**)",
      "Bash(dotnet user-secrets list*)"
    ]
  },
  "env": {
    "LC_CTYPE": "en_US.UTF-8"
  },
  "theme": "auto",
  "model": "opus",
  "advisorModel": "fable",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "azure@claude-plugins-official": false,
    "ponytail@ponytail": false
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  }
}
